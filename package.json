{
  "name": "nl2br-react",
  "version": "1.0.0",
  "description": "React component that turns newline characters into <br> elements, like PHP's nl2br.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/zakaratcha/nl2br-react"
  },
  "homepage": "https://github.com/zakaratcha/nl2br-react#readme",
  "bugs": {
    "url": "https://github.com/zakaratcha/nl2br-react/issues"
  },
  "keywords": [
    "react",
    "nl2br",
    "newline",
    "line-break",
    "br",
    "component"
  ],
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepack": "npm run build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  }
}
